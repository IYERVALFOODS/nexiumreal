    "html": "<html data-wf-domain=\"the-alps.webflow.io\" data-wf-page=\"663123a455c9b2295a7cc168\" data-wf-site=\"663123a455c9b2295a7cc16b\" lang=\"en\" class=\"w-mod-js wf-ptsans-n4-active wf-ptsans-i4-active wf-ptsans-n7-active wf-ptsans-i7-active wf-instrumentserif-n4-active wf-active w-mod-ix\"><head><meta charset=\"utf-8\"><link href=\"https://assets-global.website-files.com\" rel=\"preconnect\" crossorigin=\"anonymous\"><title>The Alps</title><meta content=\"width=device-width, initial-scale=1\" name=\"viewport\"><link href=\"https://assets-global.website-files.com/663123a455c9b2295a7cc16b/css/the-alps.84522510d.min.css\" rel=\"stylesheet\" type=\"text/css\"><link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"><link href=\"https://fonts.gstatic.com\" rel=\"preconnect\" crossorigin=\"anonymous\"><script src=\"https://ajax.googleapis.com/ajax/libs/webfont/1.6.26/webfont.js\" type=\"text/javascript\"></script><link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css?family=PT+Sans:400,400italic,700,700italic%7CInstrument+Serif:regular\" media=\"all\"><script type=\"text/javascript\">WebFont.load({  google: {    families: [\"PT Sans:400,400italic,700,700italic\",\"Instrument Serif:regular\"]  }});</script><script type=\"text/javascript\">!function(o,c){var n=c.documentElement,t=\" w-mod-\";n.className+=t+\"js\",(\"ontouchstart\"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+\"touch\")}(window,document);</script><link href=\"https://cdn.prod.website-files.com/663123a455c9b2295a7cc16b/663124e46b6d6f218e4bb81a_icon-small.jpg\" rel=\"shortcut icon\" type=\"image/x-icon\"><link href=\"https://cdn.prod.website-files.com/663123a455c9b2295a7cc16b/663124e7f661d5497ca96169_icon-large.jpg\" rel=\"apple-touch-icon\"><style>\n  @media screen and (orientation:landscape) {\n  .text {\n  \topacity: 0;\n  \t}\n  }\n</style></head><body class=\"body\"><div class=\"cusom-code w-embed\"><style>\n\t@media screen and (min-width:1400px) { body {font-size: 14px;}\t}\n  * { -webkit-tap-highlight-color:  rgba(255, 255, 255, 0);  }  \n  @keyframes moveClouds {\n    from {\n        transform: translateX(0);\n    }\n    to {\n        transform: translateX(100vw);\n    }\n}\n@media screen and (orientation:landscape) and (min-width:480px) and (max-width:767px) {\n\tbody {\n  \tbackground-color: #132142;\n  }\n  .page-wrapper {\n  \tdisplay: none;\n  }\n  .rotate-message {\n  \tdisplay: block;\n  }\n}\n.box {\n    transition: transform 2.5s cubic-bezier(0.2, 0.1, 0.2, 1), filter 2.5s cubic-bezier(0.2, 0.1, 0.2, 1); \n}\n.page-wrapper .box-sky {\n    transform: translate(0, 0);\n\n}\n.page-wrapper.loaded .box-sky {\n    transform: translate(0, -2vh);\n}\n.page-wrapper.loaded .box-mountain {\n    transform: translate(0, -2.5vh);\n}\n.page-wrapper.loaded .cloud-box.cloud-box-far{\n    transform: scale(1.1);\n}\n.page-wrapper .box-cliff{\n\t\tfilter: contrast(60%);\n}\n.page-wrapper.loaded .box-cliff{\n\t\tfilter: contrast(90%);\n    transform: scale(1.15);\n}\n.page-wrapper.loaded .cloud-box.cloud-box-mid{\n    transform: scale(1.25);\n}\n.page-wrapper .box-subject{\n\t\tfilter: contrast(80%);\n}\n.page-wrapper.loaded .box-subject{\n    transform: scale(1.4);\n\t\tfilter: contrast(100%);;\n}\n.page-wrapper.loaded .box-rock{\n    transform: scale(1.7);\n}\n.page-wrapper.loaded .cloud-box.cloud-box-near{\n    transform: scale(2);\n}\n@media screen and (orientation:landscape) {\n  .text {\n      transition: opacity .8s ease, transform 2s cubic-bezier(0.25, 0.1, 0.25, 1), filter 2s cubic-bezier(0.25, 0.1, 0.25, 1); \n      transform: scale(.6);\n  }\n  .page-wrapper.loaded .text {\n      opacity: 1;\n      transition: opacity 1.2s .8s ease-in, transform 2s cubic-bezier(0.25, 0.1, 0.25, 1), filter 2s cubic-bezier(0.25, 0.1, 0.25, 1); \n      transform: scale(1);\n  }\n}\n</style></div><div class=\"page-wrapper\"><div class=\"scene\"><div class=\"box box-sky\"><img src=\"https://cdn.prod.website-files.com/663123a455c9b2295a7cc16b/6631244a94e197f28fa153f3_sky.webp\" loading=\"eager\" alt=\"\" class=\"img img-sky\" style=\"will-change: transform; transform: translate3d(-1.10784%, 0px, 0px) scale3d(1, 1, 1) rotateX(0deg) rotateY(0deg) rotateZ(0deg) skew(0deg, 0deg); transform-style: preserve-3d;\"></div><div class=\"box box-mountain\"><img src=\"https://cdn.prod.website-files.com/663123a455c9b2295a7cc16b/66375c542422f75481dee7c6_mountain.png\" loading=\"eager\" alt=\"\" class=\"img img-mountains\" style=\"will-change: transform; transform: translate3d(-1.10784%, 0px, 0px) scale3d(1, 1, 1) rotateX(0deg) rotateY(0deg) rotateZ(0deg) skew(0deg, 0deg); transform-style: preserve-3d;\"></div><div class=\"mountain-glow\"></div><div class=\"box cloud-box cloud-box-far\"><div class=\"cloud cloud-far\" style=\"transform: translate3d(0%, 0px, 0px) scale3d(1, 1, 1) rotateX(0deg) rotateY(0deg) rotateZ(0deg) skew(0deg, 0deg); transform-style: preserve-3d;\"></div></div><div class=\"box box-cliff\"><img src=\"https://cdn.prod.website-files.com/663123a455c9b2295a7cc16b/66375c9cc7031af1d60c979a_cliff.png\" loading=\"eager\" alt=\"\" class=\"img img-cliff\" style=\"will-change: transform; transform: translate3d(0.55392%, 0px, 0px) scale3d(1, 1, 1) rotateX(0deg) rotateY(0deg) rotateZ(0deg) skew(0deg, 0deg); transform-style: preserve-3d;\"></div><div class=\"box cloud-box cloud-box-mid\"><div style=\"transform: translate3d(0%, 0px, 0px) scale3d(1, 1, 1) rotateX(0deg) rotateY(0deg) rotateZ(0deg) skew(0deg, 0deg); transform-style: preserve-3d;\" class=\"cloud\"></div></div><div class=\"box box-subject\"><img src=\"https://cdn.prod.website-files.com/663123a455c9b2295a7cc16b/66375be1c7031af1d60c12e7_subject.png\" loading=\"eager\" alt=\"\" class=\"img img-subject\" style=\"will-change: transform; transform: translate3d(1.66176%, 0px, 0px) scale3d(1, 1, 1) rotateX(0deg) rotateY(0deg) rotateZ(0deg) skew(0deg, 0deg); transform-style: preserve-3d;\"></div><div class=\"box box-rock\"><img src=\"https://cdn.prod.website-files.com/663123a455c9b2295a7cc16b/6631244a0ad209573fb103cd_rock.webp\" loading=\"eager\" alt=\"\" class=\"img img-rock\"></div><div class=\"box cloud-box cloud-box-near\"><div class=\"cloud cloud-near\" style=\"transform: translate3d(0%, 0px, 0px) scale3d(1, 1, 1) rotateX(0deg) rotateY(0deg) rotateZ(0deg) skew(0deg, 0deg); transform-style: preserve-3d;\"></div></div><div class=\"vignette\"></div></div><div class=\"text\"><h1>Conquer<br>New Heights</h1><p class=\"paragraph\">In this microsite, I explore the possibilities of web animations, inspired by Disney's Multiplane Camera. This technique was invented in 1933 as a way to simulate depth, using motion and multiple planes stacked vertically at different heights.</p><p class=\"paragraph\">Clone this demo to see how it works and use it as you like. Interested in building something awesome together? <a href=\"https://www.galvanite.io/\" target=\"_blank\">Let's talk!</a></p><div class=\"button-box\"><a href=\"https://webflow.com/made-in-webflow/website/the-alps\" target=\"_blank\" class=\"button w-button\">Clone Project</a></div></div><div class=\"lens-flare\"><img src=\"https://cdn.prod.website-files.com/663123a455c9b2295a7cc16b/663751feecb1594f747cf830_aura2.png\" loading=\"eager\" sizes=\"30vw\" srcset=\"https://assets-global.website-files.com/663123a455c9b2295a7cc16b/663751feecb1594f747cf830_aura2-p-500.png 500w, https://assets-global.website-files.com/663123a455c9b2295a7cc16b/663751feecb1594f747cf830_aura2-p-800.png 800w, https://assets-global.website-files.com/663123a455c9b2295a7cc16b/663751feecb1594f747cf830_aura2.png 924w\" alt=\"\" class=\"aura\" style=\"will-change: opacity; opacity: 0.31536;\"><div class=\"discs\" style=\"will-change: transform; transform: translate3d(0px, 0px, 0px) scale3d(1, 1, 1) rotateX(-8deg) rotateY(-15.884deg) rotateZ(-18.9216deg) skew(0deg, 0deg); transform-style: preserve-3d;\"><div class=\"disc\"></div><div class=\"disc disc2\"></div><div class=\"disc disc3\"></div><div class=\"disc disc4\"></div><div class=\"disc disc5\"></div><div class=\"disc disc6\"></div><div class=\"disc disc7\"></div></div></div><div class=\"loading-box\"><div class=\"loading-logo-box\"><div class=\"loading-logo-mask mask-1\"><img src=\"https://cdn.prod.website-files.com/663123a455c9b2295a7cc16b/663fc24ec4a616f6b3fb3bcb_logo%20top-right.svg\" loading=\"lazy\" alt=\"\" class=\"loading-logo logo-1\"></div><div class=\"loading-logo-mask mask-2\"><img src=\"https://cdn.prod.website-files.com/663123a455c9b2295a7cc16b/663fc24ec4a616f6b3fb3bdb_logo%202.svg\" loading=\"lazy\" alt=\"\" class=\"loading-logo logo-2\"></div><img src=\"https://cdn.prod.website-files.com/663123a455c9b2295a7cc16b/663fc24ec4a616f6b3fb3bf4_logo-icon-dark.svg\" loading=\"lazy\" alt=\"Galvanite Icon Dark\" class=\"loading-logo-bg\"></div><div class=\"hide w-embed\"><style>\n  .loading-box {\n    opacity: 1; /* Set initial opacity */\n    animation: fadeOutWrapper 0.5s ease-in 2.5s forwards, hideWrapper 0s linear 3s forwards;\n  }\n  .loading-logo-mask {\n    transform: rotate(225deg); /* Set initial rotation */\n    animation: rotateMask 1.25s ease 1s forwards;\n  }\n\n  .loading-logo {\n    transform: rotate(-225deg); /* Set initial rotation */\n    animation: rotateLogo 1.25s ease 1s forwards;\n  }\n  @keyframes rotateMask {\n    from {\n      transform: rotate(225deg);\n    }\n    to {\n      transform: rotate(45deg);\n    }\n  }\n\n  @keyframes rotateLogo {\n    from {\n      transform: rotate(-225deg);\n    }\n    to {\n      transform: rotate(-45deg);\n    }\n  }\n\n  @keyframes fadeOutWrapper {\n    from {\n      opacity: 1;\n    }\n    to {\n      opacity: 0;\n    }\n  }\n\n  @keyframes hideWrapper {\n    to {\n      display: none;\n    }\n  }\n</style></div></div></div><p class=\"rotate-message\">For an optimal web experience, please rotate your device to landscape mode.</p><script src=\"https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=663123a455c9b2295a7cc16b\" type=\"text/javascript\" integrity=\"sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=\" crossorigin=\"anonymous\"></script><script src=\"https://assets-global.website-files.com/663123a455c9b2295a7cc16b/js/the-alps.e31b41867.js\" type=\"text/javascript\"></script><script src=\"https://cdn.jsdelivr.net/npm/js-cookie@2/src/js.cookie.min.js\"></script>\n<script>\n  var cookieName = 'GDPR-Consent';\n\n  if(typeof Cookies.get(cookieName) !== 'undefined') {\n  $('.popup-gdpr').remove();\n  }\n\n  $('.button.gdpr').on('click', function(){\n  Cookies.set(cookieName, 'ok', { expires: 30 });\n  })\n</script>\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function() { \n  const yrSpan = document.querySelector('.current-year');\n  const currentYr = new Date().getFullYear();\n  yrSpan.textContent = currentYr;\n});\n</script><script>\n\twindow.addEventListener(\"load\", function() {\n    setTimeout(function() {\n        document.querySelector('.page-wrapper').classList.add('loaded');\n      }, 2000); \n  });\n</script></body></html>",
